---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="正在跳转至全新排障总览与故障诊断树 - 梯子避坑社"
  description="页面已升级至全新结构化排障中心，正在为您自动重定向..."
  canonicalURL="https://tizibks.com/troubleshooting/"
>
  <div class="max-w-4xl mx-auto px-4 py-20 text-center">
    <div class="inline-block p-4 rounded-2xl bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 text-amber-600 mb-4 animate-bounce">
      ⚠️
    </div>
    <h1 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">
      正在前往全新排障总览中心...
    </h1>
    <p class="text-sm text-zinc-500 mb-6">
      如果您没有被自动重定向，请点击下方链接继续访问：
    </p>
    <a
      href="/troubleshooting/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-semibold text-sm transition-colors shadow-lg shadow-amber-500/20"
    >
      <span>前往排障总览与故障诊断树 →</span>
    </a>
  </div>

  <script>
    if (typeof window !== 'undefined') {
      window.location.replace('/troubleshooting/')
    }
  </script>
</BaseLayout>
