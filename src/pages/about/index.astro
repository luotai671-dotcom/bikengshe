---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { ABOUT_ARTICLE } from '../../data/aboutArticle'
import { parseMarkdown } from '../../utils/markdown'
import { DocSidebar } from '../../components/doc/DocSidebar'
import {
  ChevronRight,
  Clock,
  Calendar,
  Tag,
  AlignLeft,
  ShieldCheck,
  Activity,
  Award
} from 'lucide-react'

const currentPath = '/about'
const { html, headings } = parseMarkdown(ABOUT_ARTICLE.content, currentPath)
---

<BaseLayout
  title={`${ABOUT_ARTICLE.title} - 梯子避坑社`}
  description={ABOUT_ARTICLE.description}
  ogType="article"
  articleMeta={{
    publishedTime: ABOUT_ARTICLE.lastUpdated,
    modifiedTime: ABOUT_ARTICLE.lastUpdated,
    tags: ABOUT_ARTICLE.tags,
    author: '梯子避坑社技术专家组'
  }}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400 mb-8 overflow-x-auto pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-emerald-500 transition-colors flex-shrink-0">首页</a>
      <ChevronRight className="w-3.5 h-3.5 text-zinc-400 flex-shrink-0" />
      <span class="font-medium text-zinc-700 dark:text-zinc-300 flex-shrink-0">关于社群</span>
      <ChevronRight className="w-3.5 h-3.5 text-zinc-400 flex-shrink-0" />
      <span class="text-zinc-800 dark:text-zinc-200 font-medium truncate" aria-current="page">关于梯子避坑社与实测准则</span>
    </nav>

    <div class="flex gap-10">
      {/* Left Category Multi-level Sidebar (Desktop) */}
      <aside class="w-64 flex-shrink-0 hidden lg:block">
        <div class="sticky top-24">
          <DocSidebar
            client:load
            currentPath={currentPath}
            headings={headings}
          />
        </div>
      </aside>

      {/* Main Content Area */}
      <main class="flex-1 min-w-0 max-w-4xl">
        {/* Header Metadata */}
        <div class="mb-8 pb-6 border-b border-zinc-200/80 dark:border-zinc-800/80">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 mb-4 shadow-sm">
            <ShieldCheck className="w-3.5 h-3.5 text-emerald-500" />
            <span>独立中立技术测评 · 100% 坚守小额月付原则</span>
          </div>

          <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-white mb-4 leading-tight">
            {ABOUT_ARTICLE.title}
          </h1>

          <div class="flex flex-wrap items-center gap-4 text-xs text-zinc-500 dark:text-zinc-400">
            <span class="flex items-center gap-1.5">
              <Calendar className="w-3.5 h-3.5 text-zinc-400" />
              公布于 {ABOUT_ARTICLE.lastUpdated}
            </span>
            <span class="flex items-center gap-1.5">
              <Clock className="w-3.5 h-3.5 text-zinc-400" />
              预计阅读 {ABOUT_ARTICLE.readingTime}
            </span>
            <span class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-medium">
              <Award className="w-3.5 h-3.5" />
              梯子避坑社技术专家组
            </span>
          </div>

          <div class="flex flex-wrap items-center gap-2 mt-4">
            {ABOUT_ARTICLE.tags.map((tag) => (
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-300 font-medium border border-zinc-200/60 dark:border-zinc-700/60">
                <Tag className="w-3 h-3 text-emerald-500" />
                {tag}
              </span>
            ))}
          </div>
        </div>

        {/* Prose Markdown Article Content */}
        <article
          class="prose prose-zinc dark:prose-invert max-w-none text-[15px] leading-relaxed
            prose-headings:font-bold prose-headings:tracking-tight prose-headings:scroll-mt-24
            prose-h1:text-2xl sm:prose-h1:text-3xl prose-h1:mb-6
            prose-h2:text-xl sm:prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-4 prose-h2:pb-2.5 prose-h2:border-b prose-h2:border-zinc-200 dark:prose-h2:border-zinc-800
            prose-h3:text-lg sm:prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
            prose-p:leading-relaxed prose-p:my-4 prose-p:text-zinc-700 dark:prose-p:text-zinc-300
            prose-ul:my-4 prose-ul:list-disc prose-ul:pl-6
            prose-ol:my-4 prose-ol:list-decimal prose-ol:pl-6
            prose-li:my-1.5 prose-li:text-zinc-700 dark:prose-li:text-zinc-300
            prose-code:text-emerald-600 dark:prose-code:text-emerald-400 prose-code:bg-emerald-50 dark:prose-code:bg-emerald-950/50 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:font-mono prose-code:text-[13px] prose-code:before:content-none prose-code:after:content-none
            prose-table:w-full prose-table:my-6 prose-table:border-collapse
            prose-th:border prose-th:border-zinc-200 dark:prose-th:border-zinc-800 prose-th:bg-zinc-50 dark:prose-th:bg-zinc-900 prose-th:p-3 prose-th:text-left prose-th:font-semibold prose-th:text-zinc-900 dark:prose-th:text-zinc-100 prose-th:text-xs
            prose-td:border prose-td:border-zinc-200 dark:prose-td:border-zinc-800 prose-td:p-3 prose-td:text-xs prose-td:text-zinc-600 dark:prose-td:text-zinc-300
            prose-blockquote:border-l-4 prose-blockquote:border-emerald-500 prose-blockquote:bg-emerald-50/50 dark:prose-blockquote:bg-emerald-950/20 prose-blockquote:py-3 prose-blockquote:px-4 prose-blockquote:rounded-r-lg prose-blockquote:my-6 prose-blockquote:not-italic"
          set:html={html}
        />

        {/* Bottom Navigation Cards */}
        <div class="mt-14 pt-8 border-t border-zinc-200 dark:border-zinc-800/80 grid grid-cols-1 md:grid-cols-2 gap-4">
          <a
            href="/buying/methodology/"
            class="group p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 hover:border-emerald-500/50 hover:shadow-lg transition-all"
          >
            <div class="text-xs text-zinc-500 dark:text-zinc-400 mb-1 flex items-center gap-1">
              <span>理论基石</span>
              <ChevronRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </div>
            <h4 class="text-base font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-500 transition-colors">
              科学网络选型评估方法论 (E-E-A-T) →
            </h4>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1 line-clamp-2">
              拆解物理链路拓扑、MTR 去回程分析、晚高峰丢包与 Jitter 抖动量化公式。
            </p>
          </a>

          <a
            href="/rankings/best/"
            class="group p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 hover:border-emerald-500/50 hover:shadow-lg transition-all"
          >
            <div class="text-xs text-zinc-500 dark:text-zinc-400 mb-1 flex items-center gap-1">
              <span>实测成果</span>
              <ChevronRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </div>
            <h4 class="text-base font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-500 transition-colors">
              2026 稳定节点综合推荐榜 →
            </h4>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1 line-clamp-2">
              基于 180 天晚高峰连续压测、全自费月付实操验证的精选专线服务榜单。
            </p>
          </a>
        </div>
      </main>
    </div>
  </div>
</BaseLayout>
