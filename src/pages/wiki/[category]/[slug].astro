---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import { getArticleData } from '../../../utils/articleLoader'
import { parseMarkdown, getRelatedTopicCluster } from '../../../utils/markdown'
import GuideNextStepsCluster from '../../../components/guide/GuideNextStepsCluster.astro'
import { DocSidebar } from '../../../components/doc/DocSidebar'
import { MobileDocDrawer } from '../../../components/doc/MobileDocDrawer'
import { WIKI_ARTICLES_LIST, WIKI_ARTICLES_MAP } from '../../../data/wikiArticles'
import {
  ChevronRight,
  Clock,
  Calendar,
  Tag,
  AlignLeft,
  ArrowUp,
  BookOpen,
  Sparkles,
  ShieldCheck
} from 'lucide-react'

export async function getStaticPaths() {
  return WIKI_ARTICLES_LIST.map((item) => ({
    params: {
      category: item.categorySlug,
      slug: item.slug
    }
  }))
}

const { category, slug } = Astro.params
const currentPath = `/wiki/${category}/${slug}`
const article = WIKI_ARTICLES_MAP[`wiki/${category}/${slug}`] || getArticleData(currentPath)
const { html, headings } = parseMarkdown(article.content, currentPath)
const relatedClusters = getRelatedTopicCluster(currentPath, 'guide')

// Extract structured FAQ items if present for JSON-LD SEO schema
let faqItems: Array<{ question: string; answer: string }> = []
const regex = /###\s+(?:Q[:：]\s*)?([^\n\r]+)[\r\n]+(?:\*\*A:\*\*\s*)?([\s\S]*?)(?=(?:###\s+|$))/g
let match
while ((match = regex.exec(article.content)) !== null) {
  const q = match[1].trim()
  const a = match[2].replace(/[*_#`]/g, '').trim()
  if (q && a && (q.includes('？') || q.includes('?') || q.includes('吗') || q.includes('如何') || q.includes('怎么') || q.includes('为什么'))) {
    faqItems.push({ question: q, answer: a.slice(0, 300) })
  }
}
if (faqItems.length === 0) {
  faqItems = [
    {
      question: `${article.title} 的核心结论是什么？`,
      answer: article.description
    }
  ]
}
---

<BaseLayout
  title={`${article.title} - 极客百科与FAQ - 梯子避坑社`}
  description={article.description}
  ogType="article"
  faqItems={faqItems}
  articleMeta={{
    publishedTime: article.lastUpdated,
    modifiedTime: article.lastUpdated,
    tags: article.tags,
    author: '梯子避坑社技术专家组'
  }}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-1.5 text-xs text-zinc-600 dark:text-zinc-300 font-medium mb-8 overflow-x-auto pb-1" aria-label="Breadcrumb">
      <a href="/" class="hover:text-emerald-500 transition-colors flex-shrink-0">首页</a>
      <ChevronRight className="w-3.5 h-3.5 text-zinc-400 flex-shrink-0" />
      <a href="/wiki/" class="hover:text-emerald-500 transition-colors flex-shrink-0">极客百科与FAQ</a>
      <ChevronRight className="w-3.5 h-3.5 text-zinc-400 flex-shrink-0" />
      <a href={`/wiki/${category}/`} class="hover:text-emerald-500 transition-colors flex-shrink-0">【{article.category}】</a>
      <ChevronRight className="w-3.5 h-3.5 text-zinc-400 flex-shrink-0" />
      <span class="text-zinc-950 dark:text-white font-bold truncate" aria-current="page">{article.title}</span>
    </nav>

    <div class="flex gap-10">
      {/* Left Category Multi-level Sidebar (Desktop) */}
      <aside class="w-64 flex-shrink-0 hidden lg:block">
        <div class="sticky top-24">
          <DocSidebar
            client:load
            currentPath={currentPath}
            headings={headings}
          />
        </div>
      </aside>

      {/* Main Content Area */}
      <main class="flex-1 min-w-0 max-w-4xl">
        {/* Header Metadata */}
        <div class="mb-6 pb-6 border-b border-zinc-200/80 dark:border-zinc-800/80">
          <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-600 dark:text-zinc-300 font-medium mb-3">
            <span class="px-2.5 py-0.5 rounded-full font-bold bg-emerald-50 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 flex items-center gap-1">
              <BookOpen className="w-3.5 h-3.5" />
              {article.category}
            </span>
            <span class="flex items-center gap-1">
              <Calendar className="w-3.5 h-3.5 text-zinc-400" />
              更新于 {article.lastUpdated}
            </span>
            <span class="flex items-center gap-1">
              <Clock className="w-3.5 h-3.5 text-zinc-400" />
              预计阅读 {article.readingTime}
            </span>
            <span class="px-2.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/90 text-zinc-700 dark:text-zinc-200 font-medium flex items-center gap-1 border border-zinc-200/60 dark:border-zinc-700/60">
              <ShieldCheck className="w-3.5 h-3.5 text-emerald-500" />
              生产级 GEO / E-E-A-T 权威认证
            </span>
          </div>

          <div class="flex flex-wrap items-center gap-2 mt-3">
            {article.tags.map((tag) => (
              <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-xs font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200/50 dark:border-zinc-700/50">
                <Tag className="w-3 h-3 text-emerald-500" />
                {tag}
              </span>
            ))}
          </div>
        </div>

        {/* Prose Markdown Article Content */}
        <article
          class="prose prose-zinc dark:prose-invert prose-emerald max-w-none text-zinc-900 dark:text-zinc-100 leading-relaxed"
          set:html={html}
        />

        {/* Next Steps Cluster */}
        <GuideNextStepsCluster
          className="mt-14"
          currentPath={currentPath}
          stuckBadge="05"
          routeBadge="06"
          readsBadge="07"
        />
      </main>

      {/* Right Table of Contents (TOC) */}
      {headings.length > 0 && (
        <aside class="w-64 flex-shrink-0 hidden xl:block">
          <div class="sticky top-24 pl-6 border-l border-zinc-200 dark:border-zinc-800 text-sm">
            <span class="flex items-center gap-1.5 font-bold text-zinc-900 dark:text-zinc-100 mb-4">
              <AlignLeft className="w-4 h-4 text-emerald-500" />
              本文技术目录
            </span>
            <nav class="space-y-2">
              {headings.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  class={`block text-[13px] font-medium text-zinc-600 dark:text-zinc-300 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors line-clamp-1 ${
                    heading.depth === 3 ? 'pl-3 text-xs text-zinc-500 dark:text-zinc-400 font-normal' : ''
                  }`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
            <div class="mt-8 pt-4 border-t border-zinc-100 dark:border-zinc-800">
              <a
                href="#top"
                class="inline-flex items-center gap-1 text-xs font-medium text-zinc-500 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors"
              >
                <ArrowUp className="w-3.5 h-3.5" />
                返回文章顶部
              </a>
            </div>
          </div>
        </aside>
      )}
    </div>
  </div>

  {/* Mobile Table of Contents Floating Drawer */}
  <MobileDocDrawer
    client:load
    headings={headings}
    currentPath={currentPath}
    title={article.title}
  />
</BaseLayout>
