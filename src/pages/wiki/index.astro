---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { WIKI_CATEGORIES, WIKI_ARTICLES_LIST } from '../../data/wikiArticles'
import { WikiFaqAccordion } from '../../components/wiki/WikiFaqAccordion'
import {
  ChevronRight,
  Sparkles,
  Shield,
  Network,
  Bot,
  Terminal,
  HelpCircle,
  ArrowRight,
  BookOpen,
  Compass,
  CheckCircle2,
  Clock,
  Search
} from 'lucide-react'

const ICON_COMPONENTS = {
  Shield,
  Network,
  Bot,
  Terminal,
  HelpCircle
}
---

<BaseLayout
  title="极客百科与常见高频 FAQ 矩阵 - 50 篇深度原理解析与避坑手册 - 梯子避坑社"
  description="梯子避坑社官方出品：全景覆盖底层协议与加密解构（VLESS/Reality/Hy2）、物理专线拓扑（IPLC/IEPL/CN2）、AI与流媒体风控解锁、客户端内核调优（TUN/Fake-IP）及 55 道高频热搜问答手风琴矩阵知识库。"
  ogType="website"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    {/* Breadcrumbs */}
    <nav class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-emerald-500 transition-colors">首页</a>
      <ChevronRight className="w-3.5 h-3.5 text-zinc-400" />
      <span class="text-zinc-800 dark:text-zinc-200 font-medium" aria-current="page">极客百科与高频 FAQ 矩阵</span>
    </nav>

    {/* Hero Banner */}
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-zinc-900 via-zinc-950 to-emerald-950 text-white p-8 sm:p-12 mb-12 border border-zinc-800 shadow-2xl">
      <div class="relative z-10 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-xs font-semibold mb-5">
          <Sparkles className="w-3.5 h-3.5" />
          <span>权威网络工程知识库 · GEO 结构化直答矩阵</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight mb-5 leading-tight">
          极客百科与常见高频 <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">FAQ 矩阵</span>
        </h1>
        <p class="text-base sm:text-lg text-zinc-300 leading-relaxed mb-6">
          拒绝黑话包装与营销套路。我们从网络七层协议栈（L3-L7）、物理海缆路由、大模型对抗风控到操作系统内核驱动，全面梳理 5 大垂直分类、50 篇生产级深度长文与 55 道高频热搜问答，为您提供经得起抓包验证的真实答案。
        </p>

        {/* 快速直达按钮组 */}
        <div class="flex flex-wrap items-center gap-3 mb-8">
          <a
            href="#faq-matrix"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-white font-bold text-xs transition-colors shadow-lg shadow-emerald-500/20"
          >
            <span>直达 55 道高频热搜问答手风琴 ↓</span>
          </a>
          <a
            href="#articles-matrix"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-zinc-800/90 hover:bg-zinc-700 text-zinc-200 font-medium text-xs border border-zinc-700 transition-colors"
          >
            <span>浏览 50 篇深度长文 ↓</span>
          </a>
        </div>

        {/* 4 Stats Chips */}
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-6 border-t border-zinc-800/80">
          <div>
            <div class="text-2xl font-black text-emerald-400 font-mono">50 篇</div>
            <div class="text-xs text-zinc-400 mt-0.5">垂直深度长文</div>
          </div>
          <div>
            <div class="text-2xl font-black text-emerald-400 font-mono">55 题</div>
            <div class="text-xs text-zinc-400 mt-0.5">热搜高权问答</div>
          </div>
          <div>
            <div class="text-2xl font-black text-emerald-400 font-mono">5 大</div>
            <div class="text-xs text-zinc-400 mt-0.5">核心技术分类</div>
          </div>
          <div>
            <div class="text-2xl font-black text-emerald-400 font-mono">100%</div>
            <div class="text-xs text-zinc-400 mt-0.5">Direct Answer 直答</div>
          </div>
        </div>
      </div>

      {/* Decorative Glow */}
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none" />
    </div>

    {/* 5 Categories Navigation Cards */}
    <div class="mb-14">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <BookOpen className="w-5 h-5 text-emerald-500" />
            5 大核心技术分类快速导航
          </h2>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
            点击直接进入对应分类专属索引，或向下浏览 50 篇全景矩阵
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
        {WIKI_CATEGORIES.map((cat, idx) => {
          const IconComp = ICON_COMPONENTS[cat.iconName] || BookOpen
          const count = WIKI_ARTICLES_LIST.filter((a) => a.categorySlug === cat.id).length

          return (
            <a
              href={`#section-${cat.id}`}
              class="group flex flex-col p-5 rounded-2xl bg-white dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 hover:border-emerald-500/50 dark:hover:border-emerald-500/50 hover:shadow-md transition-all duration-200"
            >
              <div class="flex items-center justify-between mb-3">
                <span class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800 group-hover:bg-emerald-50 dark:group-hover:bg-emerald-950/60 transition-colors">
                  <IconComp className="w-5 h-5 text-emerald-600 dark:text-emerald-400" />
                </span>
                <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 font-semibold">
                  {count} 篇
                </span>
              </div>
              <h3 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mb-1.5">
                {cat.shortName}
              </h3>
              <p class="text-xs text-zinc-500 dark:text-zinc-400 line-clamp-2 leading-relaxed flex-1">
                {cat.description}
              </p>
              <div class="pt-3 mt-3 border-t border-zinc-100 dark:border-zinc-800/60 text-[11px] font-semibold text-emerald-600 dark:text-emerald-400 flex items-center justify-between">
                <span>浏览本类目</span>
                <ChevronRight className="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
              </div>
            </a>
          )
        })}
      </div>
    </div>

    {/* ======================================================== */}
    {/* 55 道高权重热搜问答矩阵手风琴组件 (Accordion Hub) */}
    {/* ======================================================== */}
    <div class="mb-16">
      <WikiFaqAccordion client:load initialCategory="all" />
    </div>

    {/* 5 Categories Sections (50 Articles Detailed Matrix) */}
    <div id="articles-matrix" class="space-y-16 scroll-mt-24">
      {WIKI_CATEGORIES.map((cat, catIdx) => {
        const catArticles = WIKI_ARTICLES_LIST.filter((a) => a.categorySlug === cat.id)
        const IconComp = ICON_COMPONENTS[cat.iconName] || BookOpen

        return (
          <section id={`section-${cat.id}`} class="scroll-mt-24">
            {/* Section Header */}
            <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-6 border-b border-zinc-200 dark:border-zinc-800 gap-3">
              <div class="flex items-center gap-3">
                <span class="p-2.5 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                  <IconComp className="w-5 h-5" />
                </span>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">
                      分类 0{catIdx + 1}
                    </span>
                    <span class="text-[11px] px-2 py-0.2 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-500 font-medium">
                      共 10 篇精选
                    </span>
                  </div>
                  <h2 class="text-xl sm:text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 tracking-tight">
                    【{cat.name}】
                  </h2>
                </div>
              </div>

              <a
                href={cat.path}
                class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 flex items-center gap-1 group self-start sm:self-auto"
              >
                <span>进入该类目独立列表</span>
                <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
              </a>
            </div>

            {/* Articles List for this Category */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
              {catArticles.map((article, aIdx) => (
                <a
                  href={`/wiki/${article.categorySlug}/${article.slug}`}
                  class="group flex flex-col p-5 rounded-2xl bg-white dark:bg-zinc-900/50 border border-zinc-200/70 dark:border-zinc-800/80 hover:border-emerald-500/60 dark:hover:border-emerald-500/60 hover:shadow-md transition-all duration-200"
                >
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-mono text-xs font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-200/50 dark:border-emerald-800/40">
                      #{String(catIdx * 10 + aIdx + 1).padStart(2, '0')}
                    </span>
                    <span class="text-xs text-zinc-600 dark:text-zinc-300 font-medium flex items-center gap-1">
                      <Clock className="w-3.5 h-3.5 text-zinc-400" />
                      {article.readingTime}
                    </span>
                  </div>

                  <h3 class="font-extrabold text-[15px] sm:text-base text-zinc-950 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors mb-2 line-clamp-1">
                    {article.title}
                  </h3>

                  <p class="text-[13.5px] text-zinc-700 dark:text-zinc-200 line-clamp-2 leading-relaxed flex-1 mb-3.5 font-normal">
                    {article.directAnswer}
                  </p>

                  <div class="flex items-center justify-between pt-3 border-t border-zinc-100 dark:border-zinc-800/80">
                    <div class="flex flex-wrap gap-1.5">
                      {article.tags.slice(0, 2).map((tag) => (
                        <span class="text-[11.5px] font-medium px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
                          #{tag}
                        </span>
                      ))}
                    </div>
                    <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 flex items-center gap-0.5 group-hover:translate-x-1 transition-transform">
                      阅读正文
                      <ChevronRight className="w-3.5 h-3.5" />
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      })}
    </div>

    {/* Bottom Cross Reference CTA */}
    <div class="mt-20 p-8 rounded-3xl bg-gradient-to-br from-zinc-900 to-zinc-950 text-white border border-zinc-800">
      <div class="max-w-3xl">
        <h3 class="text-xl font-bold mb-2 flex items-center gap-2 text-white">
          <Compass className="w-5 h-5 text-emerald-400" />
          全站选购与评测内链直通车
        </h3>
        <p class="text-xs sm:text-sm text-zinc-400 mb-6 leading-relaxed">
          百科矩阵为您提供了坚实的网络底层理论认知。若您正在准备选购真实稳定的服务商，请直接进入我们基于 15 家主流品牌独立实测搭建的核心榜单：
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/rankings/best/"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-emerald-500 hover:bg-emerald-600 text-white shadow-sm transition-colors"
          >
            2026 稳定节点综合推荐榜 →
          </a>
          <a
            href="/rankings/iplc-iepl/"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-zinc-700 transition-colors"
          >
            晚高峰抗封锁专线评测榜 →
          </a>
          <a
            href="/rankings/ai-services/"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-zinc-700 transition-colors"
          >
            AI 生产力节点推荐 →
          </a>
          <a
            href="/rankings/streaming/"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-zinc-700 transition-colors"
          >
            4K/8K 流媒体解锁榜 →
          </a>
          <a
            href="/buying/traps/"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-zinc-700 transition-colors"
          >
            新手选购 8 大避坑法则 →
          </a>
          <a
            href="/troubleshooting/"
            class="px-4 py-2.5 rounded-xl text-xs font-semibold bg-zinc-800 hover:bg-zinc-700 text-zinc-100 border border-zinc-700 transition-colors"
          >
            排障总览与故障决策树 →
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
