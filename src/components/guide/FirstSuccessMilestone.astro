---
import {
  CheckCircle2,
  ShieldAlert,
  Compass,
  Layers,
  ArrowRight,
  Bot,
  Film,
  Gamepad2,
  Briefcase,
  AlertTriangle,
  Network,
  Cpu,
  HelpCircle,
  ExternalLink
} from 'lucide-react'

interface Props {
  className?: string
}

const { className = '' } = Astro.props

const milestones = [
  {
    step: '01',
    level: 'L1 链路基线',
    title: '客户端就绪与配置解析正常',
    desc: '客户端能正常启动且稳定常驻后台；当前配置已选中激活，订阅点击更新后能正常拉取并解析出最新节点列表与策略组。',
    checklist: [
      '客户端进程无闪退或权限拦截',
      '配置列表当前订阅显示勾选状态',
      '更新订阅能看到节点与策略组（HK/JP/US等）'
    ],
    links: [
      { text: 'Clash 订阅导入教程', href: '/kb/clients/clash-import' },
      { text: '订阅格式转换工具', href: '/tools' }
    ]
  },
  {
    step: '02',
    level: 'L2 分流基线',
    title: '开启 Rule 规则分流与双向回退',
    desc: '开启 Rule（规则分流）与系统代理后，基础海外网站稳定打开；关闭系统代理后，本地国内网络能立即恢复直连，无网络断连残留。',
    checklist: [
      '保持 Rule 模式：国内网站直连不耗流量',
      '基础网站（Google / Wikipedia）秒级响应',
      '关闭系统代理开关后，国内网络恢复如初'
    ],
    links: [
      { text: 'Rule 规则与分流模式解析', href: '/kb/concepts/glossary' },
      { text: '系统代理残留故障排查', href: '/guide/faq/' }
    ]
  },
  {
    step: '03',
    level: 'L3 业务可用',
    title: '目标服务单独验证（AI/流媒体/游戏/办公）',
    desc: '真正要用的 AI、海外流媒体、外服游戏或跨国办公服务必须单独验证。基础网页打得开绝不等于目标业务可用！',
    services: [
      { name: 'AI 大模型 (ChatGPT/Claude)', req: '需纯净原生 IP，防 403 阻断', href: '/kb/concepts/routes-explained' },
      { name: '海外流媒体 (Netflix/4K)', req: '需机房原生解锁与高吞吐带宽', href: '/kb/concepts/speed-test-guide' },
      { name: '外服游戏 (Steam/主机)', req: '需开启 TUN 虚拟网卡代理 UDP', href: '/kb/clients/clash-tun-mode' },
      { name: '跨国办公 (GitHub/Zoom)', req: '需 IPLC/IEPL 低抖动专线', href: '/kb/concepts/routes-explained' }
    ]
  },
  {
    step: '04',
    level: 'L4 排查定界',
    title: '建立“五层分层排查法”与错误留存',
    desc: '出错时能清晰判断故障卡在“订阅层 → 导入层 → 接管层 → 连通层 → 目标服务”中的哪一层，并保存完整报错日志用于定位。',
    layers: [
      { name: '1. 订阅层', desc: '账号套餐是否有效 / URL 浏览器能否下载' },
      { name: '2. 导入层', desc: '客户端 YAML 语法解析是否成功' },
      { name: '3. 接管层', desc: '系统代理或 TUN 虚拟网卡是否成功接管流量' },
      { name: '4. 连通层', desc: '节点 Ping 延迟是否有响应 / 本地时间误差<90s' },
      { name: '5. 服务层', desc: '目标网站是否封锁机房 IP / DNS 是否泄漏' }
    ],
    links: [
      { text: '五层故障排查诊断手册', href: '/troubleshoot' }
    ]
  }
]
---

<section class={`my-10 ${className}`} aria-labelledby="milestone-heading">
  {/* Section Header with 04 Numbered Badge matching design tokens */}
  <div class="flex items-center gap-2.5 mb-6 pt-8 border-t border-zinc-200/90 dark:border-zinc-800/90 group">
    <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-mono text-xs font-bold border border-emerald-500/20">
      04
    </span>
    <h2 id="04-第一次成功要满足什么" class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 flex items-center gap-1.5">
      <span>第一次成功要满足什么（核心验收基线与分层排查）</span>
      <a href="#04-第一次成功要满足什么" class="opacity-0 group-hover:opacity-100 text-zinc-400 hover:text-emerald-500 transition-opacity text-sm ml-1" aria-label="Anchor link">#</a>
    </h2>
  </div>

  {/* Direct Answer & Core Premise for AI Search Engines / Featured Snippet GEO */}
  <div class="mb-6 p-4 sm:p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/90 dark:border-zinc-800 text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed shadow-sm">
    <div class="flex items-center gap-2 font-bold text-zinc-900 dark:text-zinc-100 mb-2">
      <Compass className="w-4 h-4 text-emerald-500 flex-shrink-0" />
      <span>【新手验收核心认知 / Direct Answer】</span>
    </div>
    <p class="leading-relaxed">
      科学上网的“第一次成功”绝不仅仅是节点亮绿灯，而是建立<strong>从底层链路、规则分流到目标业务场景的确定性验收基线</strong>。完成前两项只代表基础代理链路跑通，完成第三项才代表本次目标任务真正可用；具备第四项思维才能在遇到风吹草动时秒级定位根因。
    </p>
  </div>

  {/* 4 Core Acceptance Milestones Grid */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {milestones.map((item) => (
      <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950/80 shadow-sm hover:border-emerald-500/40 transition-all flex flex-col justify-between group">
        <div class="space-y-3">
          {/* Header Badge */}
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2.5 py-0.5 rounded-full border border-emerald-200 dark:border-emerald-800/60">
              <span>{item.step}</span>
              <span class="text-zinc-400">·</span>
              <span>{item.level}</span>
            </span>
          </div>

          {/* Title */}
          <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
            {item.title}
          </h3>

          {/* Description */}
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            {item.desc}
          </p>

          {/* Specific rendering for Checklist (Items 1 & 2) */}
          {item.checklist && (
            <div class="space-y-1.5 pt-1">
              {item.checklist.map((check) => (
                <div class="flex items-start gap-2 text-xs text-zinc-700 dark:text-zinc-300">
                  <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500 flex-shrink-0 mt-0.5" />
                  <span>{check}</span>
                </div>
              ))}
            </div>
          )}

          {/* Specific rendering for Services matrix (Item 3) */}
          {item.services && (
            <div class="space-y-1.5 pt-1">
              {item.services.map((srv) => (
                <a
                  href={srv.href}
                  class="flex items-center justify-between p-2 rounded-lg bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800/80 hover:border-emerald-500/50 hover:bg-emerald-50/20 dark:hover:bg-emerald-950/20 transition-all text-xs no-underline group/srv"
                >
                  <div class="min-w-0 pr-2">
                    <span class="font-bold text-zinc-800 dark:text-zinc-200 block truncate group-hover/srv:text-emerald-500">
                      {srv.name}
                    </span>
                    <span class="text-[11px] text-zinc-500 dark:text-zinc-400 block truncate">
                      {srv.req}
                    </span>
                  </div>
                  <ArrowRight className="w-3.5 h-3.5 text-zinc-400 group-hover/srv:text-emerald-500 group-hover/srv:translate-x-0.5 transition-transform flex-shrink-0" />
                </a>
              ))}
            </div>
          )}

          {/* Specific rendering for Five-layer diagnostic model (Item 4) */}
          {item.layers && (
            <div class="space-y-1 pt-1 bg-zinc-50/70 dark:bg-zinc-900/50 p-2.5 rounded-xl border border-zinc-200/70 dark:border-zinc-800/70 text-xs">
              <div class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 mb-1 flex items-center gap-1">
                <Layers className="w-3 h-3 text-emerald-500" />
                <span>五层分界线拓扑：</span>
              </div>
              <div class="space-y-1">
                {item.layers.map((l) => (
                  <div class="flex items-baseline justify-between text-[11px] text-zinc-600 dark:text-zinc-400">
                    <span class="font-semibold text-zinc-800 dark:text-zinc-200">{l.name}</span>
                    <span class="text-zinc-400 truncate pl-2">{l.desc}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* Action Link Footer */}
        {item.links && (
          <div class="mt-4 pt-3 border-t border-zinc-100 dark:border-zinc-800/80 flex flex-wrap items-center gap-3 text-xs">
            {item.links.map((link) => (
              <a
                href={link.href}
                class="inline-flex items-center gap-1 font-semibold text-emerald-600 dark:text-emerald-400 hover:underline"
              >
                <span>{link.text}</span>
                <ArrowRight className="w-3 h-3" />
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>

  {/* Golden Rule Warning Card (复刻并升级图1底部的关键警告总结) */}
  <div class="mt-6 p-4 sm:p-5 rounded-2xl border-l-4 border-amber-500 bg-amber-500/10 dark:bg-amber-950/25 border border-amber-500/30 text-zinc-800 dark:text-zinc-200 shadow-sm relative overflow-hidden">
    <div class="flex items-start gap-3.5">
      <div class="p-2 rounded-xl bg-amber-500/20 text-amber-600 dark:text-amber-400 flex-shrink-0 mt-0.5">
        <AlertTriangle className="w-5 h-5" />
      </div>
      <div class="space-y-1.5 flex-1 min-w-0">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <span class="font-bold text-sm text-amber-950 dark:text-amber-200 flex items-center gap-1.5">
            新手避坑金律：尚未建立基线时，切勿多变量并发修改
          </span>
          <a
            href="/troubleshoot"
            class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 dark:text-amber-400 hover:underline"
          >
            <span>排障方法论 →</span>
          </a>
        </div>
        <p class="text-xs leading-relaxed text-zinc-700 dark:text-zinc-300">
          <strong>完成前两项只代表基础代理链路跑通，完成第三项才代表本次目标任务可用</strong>。绝对不要为了盲目追求极低的延迟数字，在尚未建立稳定可用基线时，<strong>同时修改 DNS、开启 TUN、更换分流规则并频繁切换多个节点</strong>！一次只调整一个变量，才能保证出错时能精确还原与排错。
        </p>
      </div>
    </div>
  </div>
</section>
